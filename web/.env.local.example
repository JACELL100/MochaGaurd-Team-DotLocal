# Public Supabase project values (safe to expose in the browser; never put the service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>

# Server-only address for FastAPI. For local development it is normally localhost.
FASTAPI_URL=http://localhost:8000
FASTAPI_TIMEOUT_MS=4000
