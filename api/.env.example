# Copy to api/.env and fill in. Never commit the real file.

# Supabase (use the POOLER string, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-or-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>

# LLM (Groq, OpenAI-compatible endpoint)
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=qwen/qwen3.8-27b
MAX_LLM_EXPLANATIONS_PER_RUN=20

# Market data
ALPHA_VANTAGE_API_KEY=<alpha-vantage-key>
# No key is needed. Used for daily-history and quote fallback when Alpha Vantage is rate limited.
YFINANCE_ENABLED=true

# Sepolia anchoring (testnet-only throwaway key)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ANCHOR_PRIVATE_KEY=0x<testnet-private-key>
CONTRACT_ADDRESS=0x<deployed-MochaAnchor-address>

# Engine tuning
SAFETY=0.8
HEADLINE_CAP=20

# Backend operation and browser origin
INTERNAL_API_KEY=<long-random-secret-for-brokerage-sync>
CORS_ORIGINS=http://localhost:3000
SCHEDULER_ENABLED=true
RUN_MIGRATIONS_ON_START=false
ENGINE_EVALUATE_SECONDS=60
